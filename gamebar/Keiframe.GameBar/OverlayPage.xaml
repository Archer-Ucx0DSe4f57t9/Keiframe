<Page
    x:Class="Keiframe.GameBar.OverlayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="PageLoaded"
    Unloaded="PageUnloaded">
    <Grid Background="#01000000">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border
            x:Name="InteractionBar"
            Grid.Row="0"
            Padding="8,6"
            Background="#EE111827">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock
                        Text="Keiframe 全屏覆盖层"
                        Foreground="White"
                        FontWeight="SemiBold"
                        FontSize="14" />
                    <TextBlock
                        x:Name="InteractionHint"
                        Text="拖动 Game Bar 标题栏移动；固定后开启点透即可控制游戏"
                        Foreground="#FFB8C2D8"
                        FontSize="11"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    Padding="10,5"
                    Content="切换锁定"
                    Click="ToggleLockClicked" />
                <Button
                    Grid.Column="2"
                    Margin="6,0,0,0"
                    Padding="10,5"
                    Content="关闭"
                    Click="CloseWidgetClicked" />
            </Grid>
        </Border>
        <Image
            x:Name="OverlayImage"
            Grid.Row="1"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Stretch="Uniform"
            IsHitTestVisible="False" />
        <Border
            x:Name="ClickThroughWarning"
            Grid.Row="1"
            Margin="8"
            Padding="10,7"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            Background="#E6A93226"
            CornerRadius="6"
            Visibility="Collapsed"
            IsHitTestVisible="False">
            <TextBlock
                Text="游戏被挡住：打开 Game Bar，点击顶部工具栏的鼠标图标启用点透，再按 Esc 返回游戏"
                Foreground="White"
                FontSize="12"
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </Border>
        <Border
            x:Name="StatusPanel"
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Padding="20,14"
            Background="#E6111827"
            CornerRadius="8"
            IsHitTestVisible="False">
            <TextBlock
                x:Name="StatusText"
                Text="正在等待 Keiframe 与全屏《星际争霸 II》…"
                Foreground="White"
                FontSize="18"
                TextAlignment="Center" />
        </Border>
    </Grid>
</Page>

<Page
    x:Class="Keiframe.GameBar.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="#111827" Padding="32">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560">
            <TextBlock
                Text="Keiframe 全屏覆盖层"
                FontSize="28"
                FontWeight="SemiBold"
                HorizontalAlignment="Center" />
            <TextBlock
                Margin="0,18,0,0"
                TextWrapping="Wrap"
                TextAlignment="Center"
                Text="请先启动 Keiframe，然后在 Xbox Game Bar 的小组件菜单中打开本小组件并将它固定。固定后可开启点击穿透。"
                FontSize="16" />
        </StackPanel>
    </Grid>
</Page>
